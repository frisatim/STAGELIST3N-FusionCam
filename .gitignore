weights/
# Les deux formes (avec et sans slash) sont necessaires : sous Windows le
# dossier est une jonction, que git peut voir comme un lien symbolique.
Modelstrained
Phase_2_Baseline_MonoCam/Modelstrained
Phase_2_Baseline_MonoCam/Modelstrained/

# Training / inference outputs
runs/
wandb/
logs/
outputs/
artifacts/

# Large generated reports from campaigns.
# Note : le dossier reports/ a la racine du depot (resumes legers) est
# versionne ; seul Phase_3_Fusion_MultiCam/reports (sorties completes de
# campagnes, jonction Windows possible) est exclu.
Phase_3_Fusion_MultiCam/reports
Phase_3_Fusion_MultiCam/reports/

